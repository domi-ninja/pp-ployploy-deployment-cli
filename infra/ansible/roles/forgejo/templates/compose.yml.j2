services:
  forgejo-db:
    image: {{ forgejo_postgres_image }}
    container_name: forgejo-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ forgejo_db_name }}
      POSTGRES_USER: {{ forgejo_db_user }}
      POSTGRES_PASSWORD: {{ forgejo_db_password }}
    volumes:
      - {{ forgejo_postgres_dir }}:/var/lib/postgresql/data
    networks:
      - forgejo-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ forgejo_db_user }} -d {{ forgejo_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 10

  forgejo:
    image: {{ forgejo_image }}
    container_name: forgejo
    depends_on:
      forgejo-db:
        condition: service_healthy
    restart: unless-stopped
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      FORGEJO__database__DB_TYPE: postgres
      FORGEJO__database__HOST: forgejo-db:5432
      FORGEJO__database__NAME: {{ forgejo_db_name }}
      FORGEJO__database__USER: {{ forgejo_db_user }}
      FORGEJO__database__PASSWD: {{ forgejo_db_password }}
      FORGEJO__server__DOMAIN: {{ forgejo_domain }}
      FORGEJO__server__SSH_DOMAIN: {{ forgejo_domain }}
      FORGEJO__server__ROOT_URL: {{ forgejo_root_url }}
      FORGEJO__server__HTTP_PORT: "{{ forgejo_http_port }}"
      FORGEJO__server__DISABLE_SSH: "false"
      FORGEJO__server__START_SSH_SERVER: "false"
      FORGEJO__server__SSH_PORT: "{{ forgejo_ssh_port }}"
      FORGEJO__security__INSTALL_LOCK: "true"
      FORGEJO__security__SECRET_KEY: {{ forgejo_secret_key }}
      FORGEJO__security__INTERNAL_TOKEN: {{ forgejo_internal_token }}
      FORGEJO__server__LFS_JWT_SECRET: {{ forgejo_lfs_jwt_secret }}
      FORGEJO__oauth2__JWT_SECRET: {{ forgejo_oauth2_jwt_secret }}
      FORGEJO__service__DISABLE_REGISTRATION: "{{ forgejo_disable_registration | ternary('true', 'false') }}"
      FORGEJO__service__REQUIRE_SIGNIN_VIEW: "{{ forgejo_require_signin_view | ternary('true', 'false') }}"
      FORGEJO__actions__ENABLED: "{{ forgejo_enable_actions | ternary('true', 'false') }}"
    volumes:
      - {{ forgejo_app_dir }}:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ forgejo_http_bind }}:{{ forgejo_http_port }}:{{ forgejo_http_port }}"
      - "{{ forgejo_ssh_bind }}:{{ forgejo_ssh_port }}:22"
    networks:
      - forgejo-internal
{% if forgejo_proxy_network | length > 0 %}
      - forgejo-proxy
{% endif %}

networks:
  forgejo-internal:
    name: forgejo-internal
{% if forgejo_proxy_network | length > 0 %}
  forgejo-proxy:
    name: {{ forgejo_proxy_network }}
    external: true
{% endif %}
