
# Local development deployment created by `pnpm convex dev`.
CONVEX_DEPLOYMENT=local:local-your-deployment-name
# Application origin
SITE_URL=http://localhost:3333
VITE_SITE_URL=http://localhost:3333

# Local Convex endpoints
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Use a different secret in production.
BETTER_AUTH_SECRET=local-development-only-secret-32-chars

# Optional local self-hosted Convex deployment. Production values belong in .env.prod.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
INSTANCE_NAME=humanist-dev
INSTANCE_SECRET=change-me
# Generated from the running local backend container if needed.
# CONVEX_SELF_HOSTED_ADMIN_KEY=humanist-dev|generated-by-container

# Local Postgres for self-hosted Convex.
POSTGRES_DB=humanist_dev
POSTGRES_USER=humanist
POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgres://humanist:change-me@postgres:5432?sslmode=disable
DATABASE_URL=postgres://humanist:change-me@postgres:5432/humanist_dev?sslmode=disable

SCALEWAY_ACCESS_KEY=XXXXXXXXXXXXXX
SCALEWAY_SECRET_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXZXXX
SCALEWAY_PROJECT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXZXXX

# Local MinIO/S3-compatible storage for self-hosted Convex.
MINIO_ROOT_USER=humanist-minio
MINIO_ROOT_PASSWORD=change-me
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=humanist-minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_DISABLE_SSE=true
S3_STORAGE_EXPORTS_BUCKET=humanist-dev-convex-exports
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=humanist-dev-convex-snapshot-imports
S3_STORAGE_MODULES_BUCKET=humanist-dev-convex-modules
S3_STORAGE_FILES_BUCKET=humanist-dev-convex-files
S3_STORAGE_SEARCH_BUCKET=humanist-dev-convex-search

# Github developer options, add oauth app
AUTH_GITHUB_ID=XXXXXXXXXXX
AUTH_GITHUB_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# When setting this up, specify
# https://something-animal-123.convex.site/api/auth/callback/github
# as the oauth callback url. The rest should be clear.

LOG_LEVEL=debug

# ./scripts/generate-jwt.js
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- XXXXXXXXXXXXXXXX......XXXXXXXXXXXXX -----END PRIVATE KEY-----"
JWKS='{"keys":[{"use":"sig","kty":"RSA","n":"XXXXXXXXXX......XXXXXXXXXXXX","e":"AQAB"}]}'
